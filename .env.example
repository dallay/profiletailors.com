# =============================================================================
# Profile Tailors — Canonical .env template
# =============================================================================
# This is the SINGLE source of truth for all environment variables used across
# the monorepo. Copy this file to .env at the project root and fill in your
# actual values, then run:
#
#   ./bin/setup-env.sh
#
# That creates a symlink (or copy on Windows) of the root .env into every
# subproject that needs it.
#
# NEVER commit real secrets to git. The .env file is gitignored.
# =============================================================================

# ── Active profile ───────────────────────────────────────────────────────────
# Leave empty for "default" (no profile). Common values: dev, test, staging.
SPRING_PROFILES_ACTIVE=

# ── Backend HTTP port ────────────────────────────────────────────────────────
# Spring Boot server port. Keep aligned with Vite proxy and CI healthcheck.
SMP_BACKEND_PORT=7638

# ── PostgreSQL (Docker Compose + Spring Boot) ────────────────────────────────
SMP_POSTGRES_DB=profiletailors_smp
SMP_POSTGRES_USER=profiletailors
SMP_POSTGRES_PASSWORD=CHANGE_ME_gK2fcFZg5cgVu9U
SMP_POSTGRES_PORT=5432

# ── R2DBC connection URL (Spring Data R2DBC) ────────────────────────────────
SMP_R2DBC_URL=r2dbc:postgresql://localhost:5432/profiletailors_smp

# ── JDBC connection URL (Liquibase) ──────────────────────────────────────────
SMP_LIQUIBASE_JDBC_URL=jdbc:postgresql://localhost:5432/profiletailors_smp

# ── Backend runtime database credentials ─────────────────────────────────────
# Consumed by spring.r2dbc and spring.liquibase blocks in application.yaml.
SMP_DB_USERNAME=profiletailors
SMP_DB_PASSWORD=CHANGE_ME_gK2fcFZg5cgVu9U

# ── Liquibase ────────────────────────────────────────────────────────────────
SMP_LIQUIBASE_ENABLED=true
# Leave unset for profile defaults: dev uses dev; every other profile uses prod.
# Deployments should set this explicitly to prod.
SMP_LIQUIBASE_CONTEXTS=prod

# ── Compatibility aliases for legacy compose fragments ───────────────────────
POSTGRES_DB=profiletailors_smp
POSTGRES_USER=profiletailors
POSTGRES_PASSWORD=CHANGE_ME_gK2fcFZg5cgVu9U
POSTGRES_PORT=5432

# ── OAuth2 Resource Server (JWT) ─────────────────────────────────────────────
SMP_JWT_ISSUER_URI=http://localhost/profiletailors-local

# ── CORS (app.security.cors) ─────────────────────────────────────────────────
# Comma-separated origins. Empty = no CORS access.
SMP_CORS_ALLOWED_ORIGINS=https://profiletailors.com,https://app.profiletailors.com,https://pt-app.localhost,https://profiletailors.localhost,https://pt-app.localhost:1355,https://profiletailors.localhost:1355
SMP_CORS_ALLOW_CREDENTIALS=true

# ── Local JWT (dev-only, no Keycloak) ────────────────────────────────────────
# Secret must be at least 256 bits (32 chars for HS256). Empty = disabled.
SMP_LOCAL_JWT_SECRET=
# Fallback used only when SMP_LOCAL_JWT_SECRET is blank. Must also be 32+ bytes.
# Leave blank in production so the application refuses to start with no secret.
SMP_LOCAL_JWT_DEV_FALLBACK=
SMP_LOCAL_JWT_ISSUER=http://localhost/profiletailors-local
SMP_LOCAL_JWT_TTL_SECONDS=900

# ── Refresh session cookie ───────────────────────────────────────────────────
SMP_REFRESH_COOKIE_NAME=pt_refresh
SMP_REFRESH_COOKIE_PATH=/api/auth
SMP_REFRESH_COOKIE_SAME_SITE=Lax
SMP_REFRESH_COOKIE_SECURE=true
SMP_REFRESH_TTL_SECONDS=604800

# ── Workspace context ────────────────────────────────────────────────────────
SMP_WORKSPACE_HEADER_NAME=X-Workspace-Id

# ── Storage ──────────────────────────────────────────────────────────────────
SMP_STORAGE_DEFAULT=attachments
SMP_STORAGE_ATTACHMENTS_BUCKET=profiletailors-attachments
SMP_STORAGE_PROVIDER_TYPE=local
SMP_STORAGE_LOCAL_BASE_PATH=./tmp/profiletailors-storage
SMP_STORAGE_R2_ACCOUNT_ID=
SMP_STORAGE_R2_ACCESS_KEY_ID=
SMP_STORAGE_R2_SECRET_ACCESS_KEY=
SMP_STORAGE_R2_ENDPOINT=

# ── Signed media previews and deduplication ──────────────────────────────────
# Base64-encoded 32-byte secret. Generate with: openssl rand -base64 32
SMP_MEDIA_PREVIEW_SIGNING_SECRET=
SMP_MEDIA_DEDUP_ENABLED=true
SMP_MEDIA_CONTEXT_INTEGRATION_ENABLED=true

# ── LinkedIn OAuth state signing ─────────────────────────────────────────────
# Base64-encoded 32-byte secret. Generate with: openssl rand -base64 32
SMP_LINKEDIN_STATE_SIGNING_SECRET=

# ── Unsplash media provider ──────────────────────────────────────────────────
SMP_MEDIAPROVIDER_UNSPLASH_BASE_URL=https://api.unsplash.com
SMP_MEDIAPROVIDER_UNSPLASH_ENABLED=false
SMP_MEDIAPROVIDER_UNSPLASH_MAX_IMPORT_BYTES=26214400
SMP_MEDIAPROVIDER_UNSPLASH_PAGE_SIZE=20
SMP_MEDIAPROVIDER_UNSPLASH_TIMEOUT=PT5S
UNSPLASH_ACCESS_KEY=

# ── Platform hooks (feature toggles) ─────────────────────────────────────────
SMP_PLATFORM_AUDIT_ENABLED=false
SMP_PLATFORM_METRICS_ENABLED=false
SMP_PLATFORM_RATE_LIMIT_ENABLED=false

# ── Waitlist rate limiting ───────────────────────────────────────────────────
SMP_WAITLIST_RATE_LIMIT_ENABLED=false
SMP_WAITLIST_RATE_LIMIT_CAPACITY=10
SMP_WAITLIST_RATE_LIMIT_REFILL_TOKENS=10
SMP_WAITLIST_RATE_LIMIT_REFILL_DURATION=PT1M

# ── Registration control ─────────────────────────────────────────────────────
# Controls public registration with OPEN, INVITE_ONLY, or CLOSED.
# Defaults to CLOSED (registration disabled) if omitted.
SMP_REGISTRATION_MODE=CLOSED

# ── Transactional emails ─────────────────────────────────────────────────────
SMP_EMAIL_SENDER=noreply@profiletailors.com
SMP_EMAIL_VERIFICATION_SUBJECT_PREFIX=[Profile Tailors]
SMP_RESEND_API_KEY=
# SMTP configuration (when set, SmtpEmailSender activates over MockEmailSender)
SMP_SMTP_HOST=
SMP_SMTP_PORT=587
SMP_SMTP_USERNAME=
SMP_SMTP_PASSWORD=

# ── MCP server (PR 1 foundation) ─────────────────────────────────────────────
# Feature flag — when true, the Spring AI MCP server transport bean is loaded
# at /api/mcp. Default false so the existing REST endpoints are unaffected.
SMP_MCP_ENABLED=false
# Canonical MCP resource URI. Must match the audience of issued access tokens.
SMP_MCP_RESOURCE_URI=https://api.profiletailors.com/api/mcp
# Audience claim that Resource Server enforces on the access token.
SMP_MCP_AUDIENCE=https://api.profiletailors.com/api/mcp
# OAuth issuer for MCP token validation (Keycloak realm URL).
# Leave empty to use the default local JWT issuer.
SMP_OAUTH_ISSUER=
# OAuth audience for MCP access tokens. Must match the audience in the JWT.
SMP_OAUTH_AUDIENCE_MCP=https://api.profiletailors.com/api/mcp

# ── Publishing worker ────────────────────────────────────────────────────────
SMP_PUBLISHING_WORKER_ENABLED=false
SMP_PUBLISHING_WORKER_POLL_INTERVAL=PT30S
SMP_PUBLISHING_WORKER_CLAIM_LEASE=PT2M
SMP_PUBLISHING_BLOCKED_RECOVERY_INTERVAL=PT5M
SMP_PUBLISHING_MAX_RETRIES=3
SMP_PUBLISHING_RETRY_BACKOFF=PT5M

# ── LinkedIn integration ─────────────────────────────────────────────────────
# Leave CLIENT_ID and CLIENT_SECRET empty to disable LinkedIn.
# When configured, the LinkedIn channel becomes available for connection.
SMP_LINKEDIN_CLIENT_ID=
SMP_LINKEDIN_CLIENT_SECRET=
SMP_LINKEDIN_REDIRECT_URI=
SMP_LINKEDIN_SCOPES=w_member_social,openid,profile,email
SMP_LINKEDIN_API_BASE_URL=https://api.linkedin.com
SMP_LINKEDIN_PUBLISHING_API_BASE_URL=https://api.linkedin.com
SMP_LINKEDIN_AUTHORIZATION_BASE_URL=https://www.linkedin.com/oauth/v2/authorization
SMP_LINKEDIN_TOKEN_BASE_URL=https://www.linkedin.com/oauth/v2/accessToken
SMP_LINKEDIN_API_VERSION=202606
SMP_LINKEDIN_SOCIAL_CONTENT_API_VERSION=202606
SMP_LINKEDIN_SOCIAL_CONTENT_SUPPORTED_API_VERSIONS=202606
SMP_LINKEDIN_SOCIAL_CONTENT_DISCOVERY_ENABLED=false
SMP_LINKEDIN_SOCIAL_CONTENT_IMPORT_ENABLED=false
SMP_LINKEDIN_SOCIAL_CONTENT_INBOX_ENABLED=false
SMP_LINKEDIN_SOCIAL_CONTENT_REPLIES_ENABLED=false
SMP_LINKEDIN_SOCIAL_CONTENT_SYNC_ENABLED=false
SMP_LINKEDIN_SOCIAL_CONTENT_RETENTION_POLICY_VERSION=
SMP_LINKEDIN_SOCIAL_CONTENT_POLL_INTERVAL=PT15M
SMP_LINKEDIN_SOCIAL_CONTENT_POLL_OVERLAP=PT10M
SMP_LINKEDIN_SOCIAL_CONTENT_POLL_PAGE_SIZE=100
SMP_LINKEDIN_SOCIAL_CONTENT_POLL_MAX_PAGES=10
SMP_LINKEDIN_SOCIAL_CONTENT_ACTIVITY_CACHE_TTL=PT48H
SMP_LINKEDIN_SOCIAL_CONTENT_COMMENTER_PROFILE_CACHE_TTL=PT24H
SMP_LINKEDIN_SOCIAL_CONTENT_QUOTA_REQUESTS_PER_MINUTE=60
SMP_LINKEDIN_SOCIAL_CONTENT_QUOTA_BURST=10
SMP_LINKEDIN_SOCIAL_CONTENT_WEBHOOKS_ENABLED=false
SMP_LINKEDIN_SOCIAL_CONTENT_WEBHOOK_SIGNING_SECRET=
SMP_LINKEDIN_SOCIAL_CONTENT_PURGE_ENABLED=false
SMP_LINKEDIN_SOCIAL_CONTENT_PURGE_INTERVAL=PT6H

# ── Credential encryption ────────────────────────────────────────────────────
# Base64-encoded 32-byte key for AES-256. Generate a new key with: openssl rand -base64 32
PUBLISHING_CREDENTIALS_ENCRYPTION_KEY=

# ── Dashboard build ──────────────────────────────────────────────────────────
# Empty uses the Vite development proxy. Release builds must set the deployed API URL.
VITE_API_BASE_URL=

# ── Dev seed (local development only, profile=dev) ────────────────────────────
# E2E uses a public test-only password versioned with its fixtures.
# NOTE: Never reuse test credentials in production.

# ── Management / Actuator ────────────────────────────────────────────────────
MANAGEMENT_PORT=9091

# ── Grafana (local development only) ─────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Waitlist form (marketing site, client-side public) ───────────────────────
# WAITLIST_API_BASE: Base URL of the SMP backend for waitlist POST requests.
#   In dev: http://localhost:7638
#   In prod: URL of the deployed SMP instance
WAITLIST_API_BASE=
# WAITLIST_ENABLED: Set to "true" to render the waitlist collection form on the
#   landing page hero. Defaults to false (shows "coming soon" message only).
#   Must be false until compliance gate (PA-004) is resolved.
WAITLIST_ENABLED=false

# ── Ahrefs Analytics (marketing site, client-side public key) ────────────────
# Used by apps/web/marketing via astro:env/client.
# Leave empty to disable analytics in local dev.
AHREFS_ANALYTICS_KEY=
