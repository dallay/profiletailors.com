# server/smp/BUILD.bazel
# ─────────────────────────────────────────────────────────────────────────────
# Social Media Platform — Spring Boot 4 / Kotlin / WebFlux backend
#
# Strategy: Spring Boot 4 with Kotlin sits right at the bleeding edge where
# rules_kotlin + rules_jvm_external work correctly BUT the Spring Boot fat-jar
# packaging (bootJar) requires a Gradle plugin or a custom Bazel rule.
# We use a genrule wrapper that calls `./gradlew bootJar` so the existing
# build produces the deployable artefact, while Bazel:
#   1. Tracks all Kotlin sources as inputs — cache invalidates on code change
#   2. Tracks build.gradle.kts / settings — cache invalidates on dep change
#   3. Exposes a named target the root BUILD can reference
#
# Migration path: once the monorepo has stabilised, replace the genrule with
# native kt_jvm_library + kt_jvm_binary targets per bounded context
# (authorization, credentials, identity, tenancy, platform, governance).
# The file structure is already bounded-context-aligned — perfect for that.
#
# Targets:
#   //server/smp:smp          — fat JAR (bootJar)
#   //server/smp:test         — run all tests via Gradle
#   //server/smp:srcs         — source filegroup (used by other targets)
# ─────────────────────────────────────────────────────────────────────────────

load("@rules_kotlin//kotlin:core.bzl", "kt_kotlinc_options")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

kt_kotlinc_options(
    name = "smp_kotlinc_opts",
    jvm_target = "21",
    x_annotation_default_target = "param-property",
    x_jsr_305 = "strict",
)

# ── Source inputs ─────────────────────────────────────────────────────────────
filegroup(
    name = "srcs",
    srcs = glob(
        [
            "src/main/kotlin/**/*.kt",
            "src/main/resources/**",
        ],
        exclude = ["**/*.DS_Store"],
    ),
)

filegroup(
    name = "test_srcs",
    srcs = glob(
        [
            "src/test/kotlin/**/*.kt",
            "src/test/resources/**",
        ],
        exclude = ["**/*.DS_Store"],
        allow_empty = True,
    ),
)

filegroup(
    name = "build_files",
    srcs = [
        "build.gradle.kts",
        "settings.gradle.kts",
        "gradlew",
    ] + glob(["gradle/**"]),
)

kt_jvm_library(
    name = "smp_lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    resources = glob(["src/main/resources/**"], allow_empty = True),
    resource_strip_prefix = "server/smp/src/main/resources",
    deps = [
        "//shared/common:common_lib",
        "//shared/spring-boot-common:spring_boot_common_lib",
        "@maven//:io_projectreactor_kotlin_reactor_kotlin_extensions",
        "@maven//:org_liquibase_liquibase_core",
        "@maven//:org_postgresql_postgresql",
        "@maven//:org_postgresql_r2dbc_postgresql",
        "@maven//:org_springdoc_springdoc_openapi_starter_webflux_ui",
        "@maven//:org_springframework_boot_spring_boot_starter_data_r2dbc",
        "@maven//:org_springframework_boot_spring_boot_starter_oauth2_resource_server",
        "@maven//:org_springframework_boot_spring_boot_starter_security",
        "@maven//:org_springframework_boot_spring_boot_starter_webflux",
        "@maven//:org_springframework_modulith_spring_modulith_starter_core",
        "@maven//:org_springframework_security_spring_security_crypto",
        "@maven//:tools_jackson_module_jackson_module_kotlin",
    ],
    kotlinc_opts = ":smp_kotlinc_opts",
)

# NOTE: `smp_lib` is a native Bazel compilation target only.
# The stable deployable artifact remains `//server/smp:smp`, which still wraps
# `./gradlew bootJar`. Native Spring Boot packaging is intentionally out of
# scope for this target so the stable backend path stays untouched.

# ── Main artefact: Spring Boot fat JAR ───────────────────────────────────────
genrule(
    name = "smp",
    srcs = [
        ":srcs",
        ":build_files",
    ],
    outs = ["smp.jar"],
    cmd = """
        set -euo pipefail
        export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$$PATH"
        OUT="$$PWD/$(OUTS)"
        PKG_DIR=$$(realpath $$(pwd)/server/smp)
        cd $$PKG_DIR

        # Build the Spring Boot fat JAR
        ./gradlew bootJar --no-daemon --quiet

        # Copy the output to Bazel's expected output location
        JAR=$$(find build/libs -name "*.jar" ! -name "*-plain.jar" | head -1)
        cp "$$JAR" "$$OUT"
    """,
    local = True,
    tags = [
        "no-remote",
        "requires-network",
    ],
)

# ── Tests via Gradle (unit + integration) ────────────────────────────────────
# Note: integration tests require Docker (Testcontainers + PostgreSQL).
# Tag them so they can be excluded from fast feedback loops:
#   bazel test //server/smp:unit_tests
#   bazel test //server/smp:integration_tests   (needs Docker)
sh_test(
    name = "unit_tests",
    srcs = ["//tools/bazel:run_in_package.sh"],
    args = [
        "server/smp",
        "./gradlew",
        "test",
        "--tests",
        "'*Test'",
        "--no-daemon",
    ],
    data = [
        ":srcs",
        ":test_srcs",
        ":build_files",
    ],
    tags = [
        "manual",
        "local",
    ],
    timeout = "long",
)

sh_test(
    name = "integration_tests",
    srcs = ["//tools/bazel:run_in_package.sh"],
    args = [
        "server/smp",
        "./gradlew",
        "test",
        "--tests",
        "'*IntegrationTest'",
        "--no-daemon",
    ],
    data = [
        ":srcs",
        ":test_srcs",
        ":build_files",
    ],
    tags = [
        "manual",
        "local",
        "requires-docker",
    ],
    timeout = "eternal",
)
