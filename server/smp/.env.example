# Docker Compose / local Spring Boot PostgreSQL configuration
# Set these before running local compose-backed services.
SMP_POSTGRES_DB=profiletailors_smp
SMP_POSTGRES_USER=profiletailors
SMP_POSTGRES_PASSWORD=CHANGE_ME
SMP_POSTGRES_PORT=5432

# Backend runtime database configuration
SMP_DB_USERNAME=profiletailors
SMP_DB_PASSWORD=CHANGE_ME
