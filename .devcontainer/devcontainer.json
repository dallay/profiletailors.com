{
  "name": "Profile Tailors",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installGradle": true,
      "gradleVersion": "9.5"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "11.11.0"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "mounts": [
    "source=profiletailors-pnpm-store,target=/home/vscode/.local/share/pnpm/store,type=volume",
    "source=profiletailors-gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "forwardPorts": [
    4321,
    5173,
    7638,
    5432,
    8089,
    8025,
    1025
  ],
  "portsAttributes": {
    "4321": { "label": "Marketing (Astro)", "onAutoForward": "notify" },
    "5173": { "label": "App (Vite + Vue)", "onAutoForward": "notify" },
    "7638": { "label": "Backend (Spring Boot)", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "8089": { "label": "WireMock", "onAutoForward": "silent" },
    "8025": { "label": "Mailpit UI", "onAutoForward": "silent" },
    "1025": { "label": "Mailpit SMTP", "onAutoForward": "silent" }
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "astro-build.astro-vscode",
        "Vue.volar",
        "vscjava.vscode-java-pack",
        "naco-vscode.gradle",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "github.vscode-github-actions"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[json]": { "editor.defaultFormatter": "biomejs.biome" },
        "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" }
      }
    }
  },
  "remoteUser": "vscode"
}
