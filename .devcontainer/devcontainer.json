{
  "name": "Profile Tailors Dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=pt-pnpm-store,target=/home/vscode/.local/share/pnpm/store,type=volume",
    "source=pt-gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "forwardPorts": [4321, 5173, 8080, 5432, 8025, 1025, 8089],
  "portsAttributes": {
    "4321": {
      "label": "Astro Marketing"
    },
    "5173": {
      "label": "Vue App"
    },
    "8080": {
      "label": "Spring Boot"
    },
    "5432": {
      "label": "PostgreSQL"
    },
    "8025": {
      "label": "Mailpit UI"
    },
    "1025": {
      "label": "Mailpit SMTP"
    },
    "8089": {
      "label": "Wiremock"
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@11.11.0 --activate && pnpm install --frozen-lockfile",
  "postStartCommand": "[ -f .env ] || cp .env.example .env || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "astro-build.astro-vscode",
        "Vue.volar",
        "redhat.java",
        "vscjava.vscode-gradle",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
