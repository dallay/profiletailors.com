{
  "name": "marketing",
  "type": "module",
  "version": "0.2.25",
  "portless": {
    "name": "profiletailors",
    "script": "dev:app"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node ../../../scripts/run-playwright.mjs",
    "test:e2e:ui": "node ../../../scripts/run-playwright.mjs --ui",
    "test:e2e:headed": "node ../../../scripts/run-playwright.mjs --headed",
    "test:e2e:debug": "node ../../../scripts/run-playwright.mjs --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/vue": "7.1.1",
    "@dallay/astro-icon": "^1.3.3",
    "@iconify-json/lucide": "^1.2.146",
    "@profiletailors/shared-web": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "tailwindcss": "^4.3.3",
    "vue": "3.5.43",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.13.0",
    "@bgotink/playwright-coverage": "^0.3.2",
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "packageExtensions": {
      "vscode-json-languageservice": {
        "dependencies": {
          "yaml": ">=2.8.3"
        }
      },
      "yaml-language-server": {
        "dependencies": {
          "yaml": ">=2.8.3"
        }
      }
    }
  }
}
