{
  "name": "marketing",
  "type": "module",
  "version": "0.0.1",
  "portless": {
    "name": "profile-tailors",
    "script": "dev:app"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@dallay/astro-icon": "^1.3.3",
    "@iconify-json/lucide": "^1.2.108",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.3",
    "tailwindcss": "^4.3.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@bgotink/playwright-coverage": "^0.3.2",
    "@biomejs/biome": "2.4.15",
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "devalue": ">=5.8.1",
      "yaml": "^2.8.3"
    },
    "packageExtensions": {
      "vscode-json-languageservice": {
        "dependencies": {
          "yaml": ">=2.8.3"
        }
      },
      "yaml-language-server": {
        "dependencies": {
          "yaml": ">=2.8.3"
        }
      }
    }
  }
}
