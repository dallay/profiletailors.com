---
import { getCollection, render } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import Nav from '@components/Nav.astro'
import type { Locale } from '@i18n/utils'
import { useTranslations } from '@i18n/utils'
import {
  buildChangelogEntryPath,
  formatChangelogDate,
  sortChangelogByDateDesc,
} from '@/lib/changelog'
import type { ChangelogCategory } from '@profiletailors/shared-web'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const langHref = locale === 'en' ? '/es/changelog/' : '/changelog/'
const rssHref = locale === 'es' ? '/es/changelog/rss.xml' : '/changelog/rss.xml'
const jsonHref = locale === 'es' ? '/es/changelog.json' : '/changelog.json'

const rawEntries = await getCollection('changelog', ({ data }) => data.locale === locale)
const sortedEntries = sortChangelogByDateDesc(
  rawEntries.map((entry) => ({
    entry,
    date: entry.data.date,
    slug: entry.data.slug,
  })),
)

const renderedEntries = await Promise.all(
  sortedEntries.map(async ({ entry }) => {
    const { Content } = await render(entry)
    return { entry, Content }
  }),
)

const categories: readonly ChangelogCategory[] = ['feature', 'improvement', 'fix', 'security']
---

<Layout
  title={t.changelog.metaTitle}
  description={t.changelog.metaDescription}
  lang={locale}
  canonicalPath="/changelog/"
  jsonLdType="WebPage"
>
  <div class="fixed inset-0 dot-grid pointer-events-none opacity-[0.06] dark:opacity-[0.14] -z-10" aria-hidden="true"></div>
  <Nav
    langSwitch={t.nav.langSwitch}
    langHref={langHref}
    langLabel={t.nav.langSwitchLabel}
    locale={locale}
  />

  <main id="main-content" class="max-w-5xl mx-auto px-6 py-14 sm:py-20" tabindex="-1">
    <header class="pb-12 border-b border-border">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.08em] text-text-secondary">
          {t.changelog.label}
        </p>
        <div class="flex items-center gap-3">
          <a
            href={rssHref}
            class="inline-flex items-center min-h-[44px] px-3 font-mono text-xs uppercase tracking-wider text-text-secondary border border-border rounded-full hover:text-text-display hover:border-border-visible transition-colors duration-150"
          >
            {t.changelog.rssLabel}
          </a>
          <a
            href={jsonHref}
            class="inline-flex items-center min-h-[44px] px-3 font-mono text-xs uppercase tracking-wider text-text-secondary border border-border rounded-full hover:text-text-display hover:border-border-visible transition-colors duration-150"
          >
            {t.changelog.jsonLabel}
          </a>
        </div>
      </div>

      <h1 class="font-display text-3xl sm:text-5xl font-light tracking-[-0.02em] text-text-display mb-4">
        {t.changelog.heading}
      </h1>
      <p class="font-display text-base sm:text-lg text-text-secondary max-w-2xl leading-relaxed">
        {t.changelog.subtitle}
      </p>

      <fieldset
        class="mt-8 flex flex-wrap gap-2 border-0 p-0 m-0"
        data-changelog-filters
      >
        <legend class="sr-only">{t.changelog.label}</legend>
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="changelog-filter-btn inline-flex items-center min-h-[44px] px-4 rounded-full font-mono text-xs uppercase tracking-[0.06em] border border-text-display bg-text-display text-bg-primary transition-colors duration-150 cursor-pointer"
        >
          {t.changelog.allCategories}
        </button>
        {categories.map((category) => (
          <button
            type="button"
            data-filter={category}
            aria-pressed="false"
            class="changelog-filter-btn inline-flex items-center min-h-[44px] px-4 rounded-full font-mono text-xs uppercase tracking-[0.06em] border border-border-visible text-text-secondary hover:text-text-display hover:border-text-secondary transition-colors duration-150 cursor-pointer"
          >
            {t.changelog.categories[category]}
          </button>
        ))}
      </fieldset>
    </header>

    <div class="divide-y divide-border" data-changelog-list>
      {renderedEntries.map(({ entry, Content }) => {
        const entryHref = buildChangelogEntryPath(locale, entry.data.slug)
        return (
          <article
            class="py-12 sm:py-16 grid grid-cols-1 md:grid-cols-[200px_1fr] gap-6 md:gap-12 items-start"
            data-changelog-entry
            data-categories={entry.data.categories.join(',')}
          >
            <aside class="md:sticky md:top-8 flex flex-row md:flex-col items-center md:items-start gap-3">
              <a
                href={entryHref}
                class="font-mono text-xs uppercase tracking-[0.06em] text-text-secondary hover:text-text-display transition-colors duration-150"
              >
                <time datetime={entry.data.date}>{formatChangelogDate(entry.data.date, locale)}</time>
              </a>
              {entry.data.version && (
                <span class="font-mono text-[11px] text-text-muted tracking-wider">
                  {entry.data.version}
                </span>
              )}
              <div class="flex flex-wrap gap-1.5 md:mt-1">
                {entry.data.categories.map((category) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full border border-border-visible font-mono text-[11px] uppercase tracking-[0.06em] text-text-secondary">
                    {t.changelog.categories[category]}
                  </span>
                ))}
              </div>
            </aside>

            <div class="min-w-0">
              <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.01em] text-text-display mb-3">
                <a
                  href={entryHref}
                  class="hover:opacity-80 transition-opacity duration-150"
                >
                  {entry.data.title}
                </a>
              </h2>
              <p class="font-display text-base text-text-secondary leading-relaxed mb-6">
                {entry.data.summary}
              </p>

              {entry.data.image && (
                <a
                  href={entryHref}
                  class="block mb-8 overflow-hidden rounded-xl border border-border bg-bg-secondary"
                >
                  <img
                    src={entry.data.image}
                    alt={entry.data.imageAlt ?? entry.data.title}
                    width="960"
                    height="540"
                    loading="lazy"
                    class="w-full h-auto block"
                  />
                </a>
              )}

              <div class="changelog-prose">
                <Content />
              </div>

              <div class="mt-8 pt-4">
                <a
                  href={entryHref}
                  class="inline-flex items-center gap-2 min-h-[44px] font-mono text-xs uppercase tracking-[0.06em] text-text-display hover:text-text-secondary transition-colors duration-150"
                >
                  <span>{t.changelog.readEntry}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        )
      })}
    </div>

    <p
      class="py-16 text-center font-mono text-sm text-text-secondary"
      hidden={renderedEntries.length > 0}
      data-changelog-empty
      role="status"
      aria-live="polite"
    >
      {renderedEntries.length === 0 ? t.changelog.emptyTimeline : t.changelog.emptyTitle}
    </p>
  </main>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-changelog-filters] [data-filter]')
  const entries = document.querySelectorAll<HTMLElement>('[data-changelog-entry]')
  const emptyState = document.querySelector<HTMLElement>('[data-changelog-empty]')

  function applyFilter(selected: string) {
    let visibleCount = 0
    for (const entry of entries) {
      const categories = (entry.dataset.categories ?? '').split(',').filter(Boolean)
      const matches = selected === 'all' || categories.includes(selected)
      entry.classList.toggle('hidden', !matches)
      if (matches) visibleCount += 1
    }

    if (emptyState) {
      emptyState.hidden = visibleCount > 0
    }

    for (const btn of buttons) {
      const active = btn.dataset.filter === selected
      btn.setAttribute('aria-pressed', active ? 'true' : 'false')
      btn.classList.toggle('bg-text-display', active)
      btn.classList.toggle('text-bg-primary', active)
      btn.classList.toggle('border-text-display', active)
      btn.classList.toggle('text-text-secondary', !active)
      btn.classList.toggle('border-border-visible', !active)
    }
  }

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      applyFilter(btn.dataset.filter ?? 'all')
    })
  }
</script>

<style is:global>
  .changelog-prose h2 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-display);
    margin-top: 1.75rem;
    margin-bottom: 0.625rem;
  }

  .changelog-prose h2:first-child {
    margin-top: 0;
  }

  .changelog-prose p {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 0.875rem;
  }

  .changelog-prose ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
    color: var(--text-secondary);
  }

  .changelog-prose li {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 0.375rem;
  }

  .changelog-prose a {
    color: var(--text-display);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .changelog-prose code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    background-color: var(--bg-surface);
  }
</style>
