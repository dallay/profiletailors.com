---
import Layout from '@layouts/Layout.astro'
import Nav from '@components/Nav.astro'
import Hero from '@components/Hero.astro'
import Scope from '@components/Scope.astro'
import Features from '@components/Features.astro'
import ProductShowcase from '@components/ProductShowcase.astro'
import LinkedInFirst from '@components/LinkedInFirst.astro'
import Trust from '@components/Trust.astro'
import Faq from '@components/Faq.astro'
import FinalCta from '@components/FinalCta.astro'
import { useTranslations } from '@i18n/utils'
import type { Locale } from '@i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const langHref = locale === 'en' ? '/es/' : '/'
const langLabel = t.nav.langSwitchLabel
---

<Layout title={t.meta.title} description={t.meta.description} lang={locale} hideVersionBadge includeAppJsonLd>
  <div class="fixed inset-0 dot-grid pointer-events-none opacity-[0.06] dark:opacity-[0.14] -z-10" aria-hidden="true"></div>
  <main id="main-content" class="fade-in relative" tabindex="-1">
    <Nav
      langSwitch={t.nav.langSwitch}
      langHref={langHref}
      langLabel={langLabel}
      locale={locale}
    />

    <Hero locale={locale} />

    <div class="border-t border-border max-w-5xl mx-auto"></div>

    <Scope locale={locale} />

    <div class="border-t border-border max-w-5xl mx-auto"></div>

    <Features title={t.features.title} items={t.features.items} />

    <div class="border-t border-border max-w-5xl mx-auto"></div>

    <ProductShowcase locale={locale} />

    <div class="border-t border-border max-w-5xl mx-auto"></div>

    <LinkedInFirst locale={locale} />

    <div class="border-t border-border max-w-5xl mx-auto"></div>

    <Trust locale={locale} />

    <div class="border-t border-border max-w-5xl mx-auto"></div>

    <Faq locale={locale} />

    <div class="border-t border-border max-w-5xl mx-auto"></div>

    <FinalCta locale={locale} />
  </main>
</Layout>
