---
import Layout from '@layouts/Layout.astro'
import Footer from '@components/Footer.astro'
import LegalPolicyUnavailable from '@components/LegalPolicyUnavailable.astro'
import { useTranslations } from '@i18n/utils'
import type { Locale } from '@i18n/utils'
import { isLegalPublicationApproved } from '../legal/legal-publication'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const policy = t.legal.cookies
const links = t.footer.legalLinks
const publicationApproved = isLegalPublicationApproved()

function renderLegalText(text: string): string {
  return text
    .split('\n\n')
    .map((p) => {
      const html = p
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="underline text-text-muted hover:text-text-display transition-colors duration-200">$1</a>')
      return `<p class="mb-4 leading-relaxed">${html}</p>`
    })
    .join('\n')
}
---

<Layout
  title={policy.title}
  description={policy.description}
  lang={locale}
  canonicalPath="/cookies/"
  jsonLdType="WebPage"
  noindex={!publicationApproved}
  includeStructuredData={publicationApproved}
>
  <div id="main-content" class="fade-in">
    {publicationApproved ? (
      <article class="max-w-3xl mx-auto px-6 py-16 sm:py-24">

      <header class="mb-12">
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-text-display mb-3">{policy.title}</h1>
        <p class="font-mono text-xs text-text-muted tracking-wide">{policy.lastUpdated}</p>
      </header>

      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">{policy.section1}</h2>
        <div set:html={renderLegalText(policy.whatAreCookies)} />
      </section>

      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">{policy.section2}</h2>
        <div set:html={renderLegalText(policy.essentialCookies)} />
      </section>

      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">{policy.section3}</h2>
        <div set:html={renderLegalText(policy.analyticsCookies)} />
      </section>

      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">{policy.section4}</h2>
        <div set:html={renderLegalText(policy.thirdPartyCookies)} />
      </section>

      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">{policy.section5}</h2>
        <div set:html={renderLegalText(policy.manageCookies)} />
      </section>

      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">{policy.section6}</h2>
        <div set:html={renderLegalText(policy.contact)} />
      </section>
      </article>
    ) : (
      <LegalPolicyUnavailable locale={locale} documentTitle={policy.title} />
    )}

    <Footer tagline={t.footer.tagline} copy={t.footer.copy} legalLinks={links} locale={locale} />
  </div>
</Layout>
