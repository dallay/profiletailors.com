---
import Layout from '@layouts/Layout.astro'
import Footer from '@components/Footer.astro'
import { useTranslations } from '@i18n/utils'
import type { Locale } from '@i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const policy = t.legal.terms
const links = t.footer.legalLinks

function renderLegalText(text: string): string {
  return text
    .split('\n\n')
    .map((p) => {
      const html = p
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="underline text-text-muted hover:text-text-display transition-colors duration-200">$1</a>')
      return `<p class="mb-4 leading-relaxed">${html}</p>`
    })
    .join('\n')
}
---

<Layout
  title={policy.title}
  description={policy.description}
  lang={locale}
  canonicalPath="/terms/"
  jsonLdType="WebPage"
>
  <div id="main-content" class="fade-in">
    <article class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
      <!-- Legal review banner -->
      <div class="border border-amber-600/30 bg-amber-600/5 rounded-lg px-4 py-3 mb-8">
        <p class="font-mono text-xs text-amber-500 tracking-wider uppercase">[LEGAL REVIEW]</p>
        <p class="font-mono text-xs text-text-muted mt-1">
          This is draft content that requires qualified legal review before production publication.
        </p>
      </div>

      <!-- Header -->
      <header class="mb-12">
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-text-display mb-3">{policy.title}</h1>
        <p class="font-mono text-xs text-text-muted tracking-wide">{policy.lastUpdated}</p>
      </header>

      <!-- Service Description & Acceptance -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">1. Service Description and Acceptance of Terms</h2>
        <div set:html={renderLegalText(policy.serviceDescription)} />
      </section>

      <!-- Account Terms -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">2. Eligibility and Account Registration</h2>
        <div set:html={renderLegalText(policy.accountTerms)} />
      </section>

      <!-- Acceptable Use -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">3. Acceptable Use</h2>
        <div set:html={renderLegalText(policy.acceptableUse)} />
      </section>

      <!-- Fees & Payment -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">4. Fees and Payment</h2>
        <div set:html={renderLegalText(policy.feesPayment)} />
      </section>

      <!-- Intellectual Property -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">5. Intellectual Property</h2>
        <div set:html={renderLegalText(policy.intellectualProperty)} />
      </section>

      <!-- Third-Party Services -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">6. Third-Party Services</h2>
        <div set:html={renderLegalText(policy.thirdPartyServices)} />
      </section>

      <!-- Disclaimer & Liability -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">7. Disclaimers and Limitation of Liability</h2>
        <div set:html={renderLegalText(policy.limitationLiability)} />
      </section>

      <!-- Termination -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">8. Suspension and Termination</h2>
        <div set:html={renderLegalText(policy.termination)} />
      </section>

      <!-- Governing Law -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">9. Governing Law</h2>
        <div set:html={renderLegalText(policy.governingLaw)} />
      </section>

      <!-- Contact -->
      <section class="mb-10">
        <h2 class="font-display text-xl font-semibold text-text-display mb-4">10. Contact</h2>
        <div set:html={renderLegalText(policy.contact)} />
      </section>
    </article>

    <Footer tagline={t.footer.tagline} copy={t.footer.copy} legalLinks={links} />
  </div>
</Layout>
