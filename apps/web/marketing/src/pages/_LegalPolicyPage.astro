---
import { getEntry, render } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import Footer from '@components/Footer.astro'
import LegalPolicyUnavailable from '@components/LegalPolicyUnavailable.astro'
import { useTranslations } from '@i18n/utils'
import type { Locale } from '@i18n/utils'
import { isLegalPublicationApproved } from '../legal/legal-publication'

interface Props {
  locale: Locale
  slug: string
}

const { locale, slug } = Astro.props
const entry = await getEntry('legal', `${locale}/${slug}`)
const { Content } = await render(entry)
const t = useTranslations(locale)
const publicationApproved = isLegalPublicationApproved()
const canonicalPath = `/${slug}/`
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  lang={locale}
  canonicalPath={canonicalPath}
  jsonLdType="WebPage"
  noindex={!publicationApproved}
  includeStructuredData={publicationApproved}
>
  <div id="main-content" class="fade-in">
    {publicationApproved ? (
      <article class="max-w-3xl mx-auto px-6 py-16 sm:py-24">

      <header class="mb-12">
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-text-display mb-3">{entry.data.title}</h1>
        <p class="font-mono text-xs text-text-muted tracking-wide">{entry.data.lastUpdated}</p>
      </header>

      <Content />
      </article>
    ) : (
      <LegalPolicyUnavailable locale={locale} documentTitle={entry.data.title} />
    )}

    <Footer tagline={t.footer.tagline} copy={t.footer.copy} legalLinks={t.footer.legalLinks} />
  </div>
</Layout>
