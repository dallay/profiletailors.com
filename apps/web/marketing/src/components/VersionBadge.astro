---
import { formatTranslation, useTranslations } from '@i18n/utils'
import type { Locale } from '@i18n/utils'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const version = __APP_VERSION__;
const shortSha = __GIT_SHA__.slice(0, 7);
const buildTime = __BUILD_TIME__;
const t = useTranslations(locale)
const displayText = formatTranslation(t.footer.versionBadge, { version, shortSha })
---

<span
  class="font-mono text-[10px] uppercase tracking-[0.18em] text-text-secondary/70"
  title={buildTime}
  data-testid="version-badge"
  aria-hidden="true"
>
  {displayText}
</span>
