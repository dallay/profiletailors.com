---
import type { Locale } from '@i18n/utils'
import { useTranslations } from '@i18n/utils'

interface Props {
  variant: 'calendar' | 'editor' | 'pipeline'
  caption: string
  locale?: Locale
}

const { variant, caption, locale = 'en' } = Astro.props
const preview = useTranslations(locale).preview
---

<figure class="border border-border-visible bg-bg-surface overflow-hidden rounded-lg">
  {variant === 'calendar' && (
    <div class="p-3 sm:p-4" aria-hidden="true">
      <div class="flex items-center justify-between mb-3">
        <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-text-secondary">{preview.week}</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-text-muted">{preview.linkedin}</span>
      </div>
      <div class="grid grid-cols-5 border-t border-l border-border">
        {preview.days.map((day, i) => (
          <div class:list={['border-r border-b border-border min-h-[132px] p-1.5', i === 2 && 'bg-bg-primary']}>
            <div class="flex items-baseline justify-between mb-2">
              <span class="font-mono text-[9px] uppercase tracking-widest text-text-secondary">{day.name}</span>
              <span class:list={['font-mono text-[11px]', i === 2 ? 'text-bg-primary bg-text-display size-5 rounded-full inline-flex items-center justify-center' : 'text-text-display']}>
                {day.date}
              </span>
            </div>
            {'time' in day && day.time && 'title' in day && day.title ? (
              <div class:list={['border bg-bg-primary px-1.5 py-1 mb-1', i === 4 ? 'border-text-display/40' : 'border-border-visible']}>
                <p class="font-mono text-[8px] uppercase tracking-wider text-text-muted">{day.time}</p>
                <p class="font-display text-[11px] text-text-body leading-tight">{day.title}</p>
              </div>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  )}

  {variant === 'editor' && (
    <div class="p-4 sm:p-5" aria-hidden="true">
      <div class="flex items-center justify-between mb-4">
        <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-text-secondary">{preview.editor.label}</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-text-muted">{preview.linkedin}</span>
      </div>
      <p class="font-display text-sm text-text-display leading-relaxed mb-4">
        {preview.editor.body}
      </p>
      <div class="flex items-center justify-between border-t border-border pt-3">
        <span class="font-mono text-[10px] text-text-muted">{preview.editor.count}</span>
        <span class="font-mono text-[10px] uppercase tracking-wider text-text-secondary">{preview.editor.status}</span>
      </div>
    </div>
  )}

  {variant === 'pipeline' && (
    <div class="grid grid-cols-3 divide-x divide-border" aria-hidden="true">
      {preview.pipeline.map((column) => (
        <div class="p-3 sm:p-4">
          <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-text-secondary mb-3">{column.col}</p>
          <ul class="flex flex-col gap-2">
            {column.items.map((item) => (
              <li class="border border-border-visible px-2 py-2 font-display text-[11px] text-text-body leading-tight">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}

  <figcaption class="border-t border-border px-4 py-2.5 font-mono text-[11px] uppercase tracking-[0.06em] text-text-secondary">
    {caption}
  </figcaption>
</figure>
