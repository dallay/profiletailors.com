---
import type { Locale } from '@i18n/utils'
import { useTranslations } from '@i18n/utils'
import WorkspacePreview from './WorkspacePreview.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const variants = ['calendar', 'editor', 'pipeline'] as const
---

<section id="product" class="px-6 pt-8 pb-24 max-w-5xl mx-auto">
  <h2 data-animate-scroll class="font-display text-3xl sm:text-4xl font-medium text-text-display tracking-tight mb-14 max-w-2xl">
    {t.product.title}
  </h2>
  <div class="flex flex-col gap-20">
    {t.product.items.map((item, i) => (
      <article
        data-animate-scroll
        class:list={[
          i === 1
            ? 'grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-8 lg:gap-12 items-center'
            : 'flex flex-col gap-6',
        ]}
      >
        <div class={i === 1 ? '' : 'max-w-xl'}>
          <h3 class="font-display text-2xl font-medium text-text-display tracking-tight mb-3">{item.title}</h3>
          <p class="font-display text-base text-text-secondary leading-relaxed max-w-md">{item.desc}</p>
        </div>
        <WorkspacePreview variant={variants[i] ?? 'calendar'} caption={t.hero.previewCaption} locale={locale} />
      </article>
    ))}
  </div>
</section>
