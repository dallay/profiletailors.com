---
import { getLocaleFromUrl, useTranslations } from "../../i18n/utils";

const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<section id="consent-banner" aria-label="Cookie consent" hidden>
  <div class="consent-container">
    <div class="consent-info">
      <h2 id="consent-heading">{t.consent.banner.heading}</h2>
      <p class="consent-description" set:html={t.consent.banner.description} />
    </div>

    <!-- Hidden toggle kept for save-preferences logic -->
    <button
      type="button"
      role="switch"
      aria-checked="false"
      aria-label="Analytics cookies"
      data-consent-analytics
      style="display:none"
    >
      <span class="consent-toggle-thumb"></span>
    </button>

    <!-- Actions -->
    <div class="consent-actions">
      <button
        type="button"
        data-consent-accept-all
        class="consent-button consent-button--primary"
      >
        {t.consent.action.acceptAll}
      </button>
      <button
        type="button"
        data-consent-reject-all
        class="consent-button consent-button--primary"
      >
        {t.consent.action.rejectAll}
      </button>
      <button
        type="button"
        data-consent-save
        class="consent-button consent-button--secondary"
      >
        {t.consent.action.savePreferences}
      </button>
    </div>
  </div>
</section>

<style>
  #consent-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    padding: 1rem;
    pointer-events: none;
  }

  #consent-banner[hidden] {
    display: none;
  }

  .consent-container {
    pointer-events: auto;
    max-width: 760px;
    margin: 0 auto;
    /* The banner is always dark (system-style toast) in both themes, so it
       must not inherit light-mode text tokens designed for light surfaces. */
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.3);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
  }

  .consent-info {
    min-width: 0;
  }

  #consent-heading {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
  }

  .consent-description {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    /* #a3a3a3 on #1a1a1a is 5.0:1 — passes WCAG AA in both themes */
    color: #a3a3a3;
  }

  .consent-description :global(a) {
    /* The banner surface is always dark (#1a1a1a) in both themes, so the link
       must use a fixed light-on-dark color instead of the theme accent, which
       is near-black in light mode. #0ea5e9 on #1a1a1a is ~6.5:1 (WCAG AA). */
    color: #0ea5e9;
    text-decoration: underline;
  }

  .consent-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .consent-button {
    white-space: nowrap;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 2px solid transparent;
  }

  .consent-button--primary,
  .consent-button--secondary {
    background: var(--color-surface, #333);
    color: var(--color-text, #fff);
    border-color: var(--color-border, #444);
  }

  .consent-button--primary:hover,
  .consent-button--secondary:hover {
    background: var(--color-surface-hover, #3a3a3a);
    border-color: var(--color-accent, #0ea5e9);
  }

  @media (prefers-reduced-motion: reduce) {
    .consent-button {
      transition: none;
    }

    #consent-banner {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .consent-container {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

    .consent-actions {
      justify-content: stretch;
    }

    .consent-button {
      flex: 1;
    }
  }
</style>

<script>
  import {
    CURRENT_CONSENT_VERSION,
    CURRENT_POLICY_VERSION,
    PT_CONSENT_KEY,
  } from "../../constants/consent";
  import type { ConsentReceipt } from "@profiletailors/shared-web";
  import { validateConsentReceipt } from "@profiletailors/shared-web";

  // --- Banner logic ---

  function initConsentBanner() {
    const banner = document.getElementById("consent-banner");
    if (!banner) return;

    const analyticsToggle = banner.querySelector(
      "[data-consent-analytics]",
    ) as HTMLButtonElement;
    const acceptBtn = banner.querySelector(
      "[data-consent-accept-all]",
    ) as HTMLButtonElement;
    const rejectBtn = banner.querySelector(
      "[data-consent-reject-all]",
    ) as HTMLButtonElement;
    const saveBtn = banner.querySelector(
      "[data-consent-save]",
    ) as HTMLButtonElement;

    // Check if banner should be shown
    const existingConsent = loadConsent();
    const hasDNT = window.__PT_DNT || false;

    if (!existingConsent) {
      // Set default based on DNT/GPC
      const defaultAnalytics = !hasDNT;
      analyticsToggle.setAttribute("aria-checked", String(defaultAnalytics));
      if (defaultAnalytics) {
        analyticsToggle.classList.add("consent-toggle--on");
      }
      banner.removeAttribute("hidden");
    }

    // Toggle analytics
    analyticsToggle?.addEventListener("click", () => {
      const isChecked = analyticsToggle.getAttribute("aria-checked") === "true";
      analyticsToggle.setAttribute("aria-checked", String(!isChecked));
      analyticsToggle.classList.toggle("consent-toggle--on");
    });

    // Accept all
    acceptBtn?.addEventListener("click", () => {
      saveConsentChoice(true);
      closeBanner();
    });

    // Reject all
    rejectBtn?.addEventListener("click", () => {
      saveConsentChoice(false);
      closeBanner();
    });

    // Save preferences
    saveBtn?.addEventListener("click", () => {
      const analytics = analyticsToggle.getAttribute("aria-checked") === "true";
      saveConsentChoice(analytics);
      closeBanner();
    });
  }

  function saveConsentChoice(analytics: boolean) {
    const receipt: ConsentReceipt = {
      consentVersion: CURRENT_CONSENT_VERSION,
      policyVersion: CURRENT_POLICY_VERSION,
      timestamp: new Date().toISOString(),
      region: "EU",
      categories: {
        necessary: true,
        analytics,
      },
      dnt: window.__PT_DNT || false,
      source: "banner",
    };

    try {
      localStorage.setItem(PT_CONSENT_KEY, JSON.stringify(receipt));
      // Reload to apply changes
      window.location.reload();
    } catch (error) {
      console.error("[Consent] Failed to save:", error);
    }
  }

  function loadConsent(): ConsentReceipt | null {
    try {
      const raw = localStorage.getItem(PT_CONSENT_KEY);
      if (!raw) return null;
      // Use shared validation schema
      const parsed = JSON.parse(raw);
      return validateConsentReceipt(parsed);
    } catch {
      return null;
    }
  }

  function closeBanner() {
    const banner = document.getElementById("consent-banner");
    banner?.setAttribute("hidden", "");
  }

  // Initialize on load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initConsentBanner);
  } else {
    initConsentBanner();
  }
</script>
