---
import { useTranslations } from '../../i18n/utils'
import type { Locale } from '../../i18n/utils'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
---

<aside
  id="consent-banner"
  data-testid="consent-banner"
  aria-labelledby="consent-heading"
  aria-describedby="consent-description"
  hidden
>
  <div class="consent-container">
    <h2 id="consent-heading">{t.consent.banner.heading}</h2>
    <p id="consent-description" class="consent-description" set:html={t.consent.banner.description} />

    <div class="consent-actions" data-consent-summary>
      <button type="button" data-consent-reject-all class="consent-button">
        {t.consent.action.rejectAll}
      </button>
      <button
        type="button"
        data-consent-customize
        aria-controls="consent-customize-panel"
        aria-expanded="false"
        class="consent-button"
      >
        {t.consent.action.customize}
      </button>
      <button type="button" data-consent-accept-all class="consent-button">
        {t.consent.action.acceptAll}
      </button>
    </div>

    <div id="consent-customize-panel" data-consent-customize-panel hidden>
      <div class="consent-category consent-category--disabled">
        <div class="consent-category-info">
          <label class="consent-category-label" for="consent-necessary">
            {t.consent.category.necessary.label}
          </label>
          <span class="consent-category-desc">
            {t.consent.category.necessary.description}
          </span>
        </div>
        <input
          type="checkbox"
          id="consent-necessary"
          checked
          disabled
          aria-disabled="true"
          class="consent-checkbox"
        />
      </div>

      <div class="consent-category">
        <div class="consent-category-info">
          <span class="consent-category-label">
            {t.consent.category.analytics.label}
          </span>
          <span class="consent-category-desc">
            {t.consent.category.analytics.description}
          </span>
        </div>
        <button
          type="button"
          role="switch"
          aria-checked="false"
          aria-label={t.consent.category.analytics.label}
          data-consent-analytics
          class="consent-toggle"
        >
          <span class="consent-toggle-thumb"></span>
        </button>
      </div>

      <div class="consent-actions consent-actions--customize">
        <button type="button" data-consent-back class="consent-button">
          {t.consent.action.back}
        </button>
        <button type="button" data-consent-save class="consent-button">
          {t.consent.action.savePreferences}
        </button>
      </div>
    </div>
  </div>
</aside>

<style>
  #consent-banner {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 40;
    padding: 1rem;
    padding-bottom: calc(env(safe-area-inset-bottom) + 1rem);
    pointer-events: none;
  }

  #consent-banner[hidden],
  [data-consent-customize-panel][hidden] {
    display: none;
  }

  .consent-container {
    width: 100%;
    max-height: calc(100dvh - 2rem);
    margin: 0 auto;
    overflow-y: auto;
    padding: 1.25rem;
    pointer-events: auto;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 12px;
  }

  #consent-heading {
    margin: 0 0 0.5rem;
    color: #ffffff;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .consent-description {
    margin: 0 0 1rem;
    color: #a3a3a3;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .consent-description :global(a) {
    color: #0ea5e9;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .consent-category {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    padding: 1rem;
    background: #222222;
    border: 1px solid #333;
    border-radius: 8px;
  }

  .consent-category--disabled {
    background: #242424;
    border-color: #2e2e2e;
  }

  .consent-category-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
  }

  .consent-category-label {
    color: #ffffff;
    font-weight: 600;
  }

  .consent-category-desc {
    color: #a3a3a3;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .consent-category--disabled .consent-category-desc {
    color: #d4d4d4;
  }

  .consent-checkbox {
    width: 20px;
    height: 20px;
  }

  .consent-toggle {
    position: relative;
    width: 44px;
    height: 24px;
    flex: 0 0 auto;
    padding: 0;
    background: #444444;
    border: 0;
    border-radius: 12px;
    cursor: pointer;
  }

  .consent-toggle[aria-checked="true"] {
    background: #ffffff;
  }

  .consent-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: #ffffff;
    border-radius: 50%;
  }

  .consent-toggle[aria-checked="true"] .consent-toggle-thumb {
    background: #0a0a0a;
    transform: translateX(20px);
  }

  .consent-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .consent-actions--customize {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .consent-button {
    min-height: 44px;
    padding: 0.75rem 1rem;
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    background: #333333;
    border: 1px solid #444444;
    border-radius: 8px;
    cursor: pointer;
  }

  .consent-button:hover {
    background: #3a3a3a;
    border-color: #ffffff;
  }

  .consent-button:focus-visible,
  .consent-toggle:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  @media (min-width: 641px) {
    #consent-banner {
      right: 1.5rem;
      bottom: 1.5rem;
      left: auto;
      width: min(40rem, calc(100vw - 3rem));
      padding: 0;
    }
  }

  @media (max-width: 640px) {
    .consent-actions,
    .consent-actions--customize {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent-toggle-thumb {
      transition: none;
    }
  }
</style>

<script>
  import { CURRENT_CONSENT_VERSION, CURRENT_POLICY_VERSION, PT_CONSENT_KEY } from '../../constants/consent'
  import type { ConsentReceipt } from '@profiletailors/shared-web'
  import { validateConsentReceipt } from '@profiletailors/shared-web'

  function initConsentBanner() {
    const banner = document.getElementById('consent-banner')
    if (!banner) return

    const analyticsToggle = banner.querySelector('[data-consent-analytics]') as HTMLButtonElement
    const acceptBtn = banner.querySelector('[data-consent-accept-all]') as HTMLButtonElement
    const rejectBtn = banner.querySelector('[data-consent-reject-all]') as HTMLButtonElement
    const customizeBtn = banner.querySelector('[data-consent-customize]') as HTMLButtonElement
    const customizePanel = banner.querySelector('[data-consent-customize-panel]') as HTMLElement
    const backBtn = banner.querySelector('[data-consent-back]') as HTMLButtonElement
    const saveBtn = banner.querySelector('[data-consent-save]') as HTMLButtonElement

    const existingConsent = loadConsent()
    const hasDNT = window.__PT_DNT || false

    function setAnalyticsToggle(enabled: boolean) {
      analyticsToggle.setAttribute('aria-checked', String(enabled))
      analyticsToggle.classList.toggle('consent-toggle--on', enabled)
    }

    function setCustomizeOpen(open: boolean) {
      customizePanel.toggleAttribute('hidden', !open)
      customizeBtn.setAttribute('aria-expanded', String(open))

      if (open) {
        setAnalyticsToggle(existingConsent?.categories.analytics ?? !hasDNT)
      }
    }

    if (!existingConsent) {
      banner.removeAttribute('hidden')
    }

    customizeBtn?.addEventListener('click', () => setCustomizeOpen(true))
    backBtn?.addEventListener('click', () => setCustomizeOpen(false))

    banner.addEventListener('consent-open-settings', () => {
      banner.removeAttribute('hidden')
      setCustomizeOpen(true)
    })

    analyticsToggle?.addEventListener('click', () => {
      const isChecked = analyticsToggle.getAttribute('aria-checked') === 'true'
      setAnalyticsToggle(!isChecked)
    })

    acceptBtn?.addEventListener('click', () => {
      saveConsentChoice(true)
      closeBanner()
    })

    rejectBtn?.addEventListener('click', () => {
      saveConsentChoice(false)
      closeBanner()
    })

    saveBtn?.addEventListener('click', () => {
      const analytics = analyticsToggle.getAttribute('aria-checked') === 'true'
      saveConsentChoice(analytics)
      closeBanner()
    })
  }

  function saveConsentChoice(analytics: boolean) {
    const receipt: ConsentReceipt = {
      consentVersion: CURRENT_CONSENT_VERSION,
      policyVersion: CURRENT_POLICY_VERSION,
      timestamp: new Date().toISOString(),
      region: 'EU',
      categories: {
        necessary: true,
        analytics,
      },
      dnt: window.__PT_DNT || false,
      source: 'banner',
    }

    try {
      localStorage.setItem(PT_CONSENT_KEY, JSON.stringify(receipt))
      window.location.reload()
    } catch (error) {
      console.error('[Consent] Failed to save:', error)
    }
  }

  function loadConsent(): ConsentReceipt | null {
    try {
      const raw = localStorage.getItem(PT_CONSENT_KEY)
      if (!raw) return null
      return validateConsentReceipt(JSON.parse(raw))
    } catch {
      return null
    }
  }

  function closeBanner() {
    document.getElementById('consent-banner')?.setAttribute('hidden', '')
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initConsentBanner)
  } else {
    initConsentBanner()
  }
</script>
