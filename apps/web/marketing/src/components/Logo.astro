---
import Logo from '../assets/profiletailors-logotype.svg'

interface Props {
  size?: 'sm' | 'md' | 'lg'
  showBrand?: boolean
}

const { size = 'md', showBrand = true } = Astro.props

const sizes = {
  sm: { svg: 'w-5 h-5', text: 'text-sm' },
  md: { svg: 'w-7 h-7', text: 'text-base' },
  lg: { svg: 'w-9 h-9', text: 'text-lg' },
}
---

<a href="/" class="inline-flex items-center gap-2 group" aria-label="Profile Tailors">
  <Logo
    class:list={['flex-shrink-0 transition-transform duration-300 group-hover:scale-105 text-text-display', sizes[size].svg]}
    aria-hidden="true"
  />
  {showBrand && (
    <span class:list={['font-display font-medium text-text-display tracking-tight whitespace-nowrap', sizes[size].text]}>
      Profile Tailors
    </span>
  )}
</a>
