---
import type { Locale } from '@i18n/utils'
import { WAITLIST_API_BASE } from 'astro:env/client'
import { useTranslations } from '@i18n/utils'
import { waitlistShareUrl } from './waitlist-share'

interface Props {
  locale: Locale
  waitlistKey?: string
  source?: string
  formId?: string
  apiBase?: string
  ariaLabel?: string
}

const { locale, waitlistKey, source, formId = 'waitlist-hero', apiBase, ariaLabel } = Astro.props
const resolvedApiBase = apiBase ?? WAITLIST_API_BASE
const t = useTranslations(locale)
const wl = t.waitlist
const resolvedAriaLabel = ariaLabel ?? wl.formAriaLabel
const emailId = `${formId}-email`
const marketingId = `${formId}-marketing`
const errorId = `${formId}-error`
---

<form
  data-waitlist-form
  data-waitlist-key={waitlistKey ?? 'profile-tailors-launch'}
  data-waitlist-source={source ?? 'marketing-site'}
  data-waitlist-form-id={formId}
  data-waitlist-locale={locale}
  data-waitlist-api-base={resolvedApiBase}
  aria-label={resolvedAriaLabel}
  data-waitlist-share-url={waitlistShareUrl(locale)}
  data-waitlist-share-title={wl.shareTitle}
  data-waitlist-share-copied={wl.shareCopied}
  data-waitlist-messages={JSON.stringify({
    validEmail: wl.errorValidEmail,
    tooManyRequests: wl.errorTooManyRequests,
    genericError: wl.errorGeneric,
    success: wl.success,
  })}
  novalidate
  class="flex flex-col gap-4 max-w-md"
>
  <div class="flex flex-col gap-1.5">
    <label for={emailId} class="font-mono text-xs uppercase tracking-[0.08em] text-text-secondary">
      {wl.emailLabel}
    </label>
    <input
      id={emailId}
      data-waitlist-email
      type="email"
      inputmode="email"
      autocomplete="email"
      required
      placeholder={wl.emailInput.placeholder}
      aria-describedby={errorId}
      aria-label={wl.emailInput.ariaLabel}
      class="bg-transparent border-b border-border-visible focus:border-text-display py-2.5 text-text-display font-mono text-sm placeholder:text-text-muted focus:outline-none transition-colors duration-200"
    />
  </div>

  <div class="flex items-start gap-2.5 text-sm text-text-secondary">
    <input
      id={marketingId}
      data-waitlist-consent-marketing
      type="checkbox"
      class="mt-0.5 min-h-[20px] min-w-[20px] accent-text-display cursor-pointer"
    />
    <label for={marketingId} class="cursor-pointer select-none leading-relaxed">{wl.consentMarketing.label}</label>
  </div>

  <p
    data-waitlist-error
    id={errorId}
    role="alert"
    aria-live="polite"
    class="hidden text-sm text-error-text"
  ></p>

  <div data-waitlist-success role="status" aria-live="polite" class="hidden text-sm text-text-display">
    <p>{wl.success}</p>
    <p class="text-text-secondary mt-1">{wl.successNext}</p>
    <button
      data-waitlist-share
      type="button"
      class="inline-flex items-center min-h-[44px] font-mono text-xs uppercase tracking-[0.06em] text-text-display underline underline-offset-4 cursor-pointer bg-transparent border-0 p-0"
    >
      {wl.shareLabel}
    </button>
  </div>

  <button
    data-waitlist-submit
    type="submit"
    class="font-mono text-xs font-bold uppercase tracking-[0.06em] bg-text-display text-bg-primary rounded-full px-8 py-3.5 min-h-[44px] hover:opacity-90 active:scale-[0.98] transition-all duration-150 disabled:opacity-40 disabled:cursor-not-allowed shadow-none mt-1 sm:self-start w-full sm:w-auto cursor-pointer"
  >
    {wl.submit}
  </button>

  <p class="font-display text-sm text-text-secondary leading-relaxed">{wl.hint}</p>
</form>
