---
import ThemeToggle from './ThemeToggle.astro'
import Logo from './Logo.astro'
import type { Locale } from '@i18n/utils'

interface Props {
  langSwitch: string
  langHref: string
  langLabel: string
  locale?: Locale
}

const { langSwitch, langHref, langLabel, locale } = Astro.props
---

<nav aria-label="Main" class="flex items-center justify-between px-6 py-5 max-w-4xl mx-auto border-b border-border/40">
  <Logo size="md" locale={locale} />
  <div class="flex items-center gap-6">
    <ThemeToggle />
    <a
      href={langHref}
      class="font-mono text-xs tracking-wider uppercase text-text-secondary hover:text-text-display transition-colors duration-200 inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-2"
      aria-label={langLabel}
    >
      {langSwitch}
    </a>
  </div>
</nav>
