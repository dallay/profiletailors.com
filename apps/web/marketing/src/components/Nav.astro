---







import ThemeToggle from './ThemeToggle.astro'
import Logo from './Logo.astro'

interface Props {
  langSwitch: string
  langHref: string
  langLabel: string
}

const { langSwitch, langHref, langLabel } = Astro.props
---

<nav aria-label="Main" class="flex items-center justify-between px-6 py-5 max-w-4xl mx-auto">
  <Logo size="md" />
  <div class="flex items-center gap-6">
    <ThemeToggle />
    <a
      href={langHref}
      class="font-mono text-xs tracking-widest text-text-muted hover:text-text-display transition-colors duration-200"
      aria-label={langLabel}
    >
      {langSwitch}
    </a>
  </div>
</nav>
