---
import EarlyAccessStatus from './EarlyAccessStatus.astro'
import WaitlistForm from './WaitlistForm.astro'
import type { Locale } from '@i18n/utils'
import { WAITLIST_ENABLED } from 'astro:env/client'

interface Props {
  label: string
  headline: string
  sub: string
  status: string
  locale: Locale
}

const { label, headline, sub, status, locale } = Astro.props
const showWaitlistForm = WAITLIST_ENABLED
---

<section class="px-6 pt-20 pb-24 max-w-4xl mx-auto">
  <div
    data-hero-label
    class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border-visible bg-bg-surface/60 font-mono text-xs tracking-wider text-text-secondary uppercase mb-8"
  >
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
    <span>{label}</span>
  </div>

  <h1
    data-hero-headline
    class="font-display text-5xl sm:text-6xl lg:text-7xl font-medium text-text-display leading-[1.05] tracking-tight mb-6 whitespace-pre-line"
  >
    {headline}
  </h1>

  <p
    data-hero-sub
    class="font-display text-lg text-text-secondary max-w-xl leading-relaxed mb-12"
  >
    {sub}
  </p>

  {showWaitlistForm ? (
    <div data-hero-form data-hero-form-active>
      <WaitlistForm locale={locale} />
      <noscript>
        <EarlyAccessStatus message={status} />
      </noscript>
    </div>
  ) : (
    <div data-hero-form>
      <EarlyAccessStatus message={status} />
    </div>
  )}
</section>

<script>
  import { initHeroAnimations } from '../scripts/hero-animations'
  import { initScrollReveal } from '../scripts/scroll-reveal'

  document.addEventListener('DOMContentLoaded', () => {
    initHeroAnimations()
    initScrollReveal()
  })
</script>
