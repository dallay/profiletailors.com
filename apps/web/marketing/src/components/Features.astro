---
interface FeatureItem {
  tag: string
  title: string
  desc: string
}

interface Props {
  title: string
  items: readonly FeatureItem[]
}

const { title, items } = Astro.props
---

<section class="px-6 pt-8 pb-24 max-w-5xl mx-auto">
  <h2 data-animate-scroll class="font-display text-3xl sm:text-4xl font-medium text-text-display tracking-tight mb-12 max-w-2xl">
    {title}
  </h2>

  <div class="flex flex-col">
    {items.map((feature, i) => (
      <div
        data-animate-scroll
        class="grid grid-cols-1 sm:grid-cols-[160px_1fr] gap-3 sm:gap-10 py-8 border-t border-border last:border-b"
        style={`transition-delay: ${i * 80}ms`}
      >
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-text-secondary pt-1">
          {feature.tag}
        </p>
        <div>
          <h3 class="font-display text-xl sm:text-2xl font-medium text-text-display mb-2.5 tracking-tight">
            {feature.title}
          </h3>
          <p class="font-display text-base text-text-secondary leading-relaxed max-w-2xl">
            {feature.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
