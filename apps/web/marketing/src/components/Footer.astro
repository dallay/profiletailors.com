---















import CookieSettingsLink from '@components/consent/CookieSettingsLink.astro'

interface Props {
  tagline: string
  copy: string
  legalLinks?: readonly { label: string; href: string }[]
}

const { tagline, copy, legalLinks } = Astro.props
---

<footer class="px-6 py-10 max-w-4xl mx-auto">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div data-animate-scroll>
      <p class="font-mono text-xs text-text-muted tracking-widest mb-1">PROFILE TAILORS</p>
      <p class="font-display text-sm text-text-muted">{tagline}</p>
    </div>
    <p class="font-mono text-xs text-text-muted">{copy}</p>
  </div>
  {(legalLinks && legalLinks.length > 0) && (
    <nav aria-label="Legal" class="border-t border-bg-surface mt-6 pt-6 flex flex-wrap gap-x-6 gap-y-2">
      {legalLinks.map((link) => (
        <a href={link.href} class="font-mono text-xs text-text-muted hover:text-text-display transition-colors duration-200">
          {link.label}
        </a>
      ))}
      <CookieSettingsLink />
    </nav>
  )}
</footer>
