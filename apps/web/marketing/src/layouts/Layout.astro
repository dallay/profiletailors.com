---
import "@styles/global.css";
import type { Locale } from "@i18n/utils";
import Analytics from "@components/Analytics.astro";
import ConsentScript from "@components/consent/ConsentScript.astro";
import ConsentBanner from "@components/consent/ConsentBanner.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  image?: string;
  sameAs?: string[];
  canonicalPath?: string;
  jsonLdType?: "WebSite" | "WebPage";
  noindex?: boolean;
  includeStructuredData?: boolean;
}

const {
  title = "Profile Tailors — Social content planning in development",
  description = "Preview Profile Tailors, a social content planning workspace currently in development.",
  lang = "en",
  image,
  sameAs,
  canonicalPath,
  jsonLdType = "WebSite",
  noindex = false,
  includeStructuredData = true,
} = Astro.props;

const path = canonicalPath ?? "/";
const baseUrl = Astro.site ?? "https://profiletailors.com";
const canonicalEN = new URL(path, baseUrl).href;
const canonicalES = new URL(path === "/" ? "/es/" : `/es${path}`, baseUrl).href;
const canonical = lang === "en" ? canonicalEN : canonicalES;
const ogImage = image ?? (lang === "en" ? "/og-en.svg" : "/og-es.svg");
const robotsContent = noindex
  ? "noindex,nofollow,noarchive"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const siteName = "Profile Tailors";

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": jsonLdType,
  name: "Profile Tailors",
  description: description,
  url: canonical,
  inLanguage: lang,
  ...(sameAs && sameAs.length > 0 ? { sameAs } : {}),
};
const jsonLdString = JSON.stringify(jsonLd);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Consent check: must run before Analytics -->
    <ConsentScript />
    <!-- Theme: must run synchronously before first paint to prevent FOUC -->
    <script is:inline>
      (() => {
        var saved = localStorage.getItem("theme");
        if (saved === "light") {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.classList.add("dark");
        } else if (saved === "dark") {
          document.documentElement.removeAttribute("data-theme");
          document.documentElement.classList.remove("dark");
        } else {
          // No saved preference — respect OS setting
          if (globalThis.matchMedia("(prefers-color-scheme: light)").matches) {
            document.documentElement.setAttribute("data-theme", "light");
            document.documentElement.classList.add("dark");
          }
          // Dark is the default (:root tokens) — no attribute needed
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang="en" href={canonicalEN} />
    <link rel="alternate" hreflang="es" href={canonicalES} />
    <link rel="alternate" hreflang="x-default" href={canonicalEN} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "es_ES" : "en_US"}
    />
    <meta property="og:image" content={new URL(ogImage, baseUrl).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@profiletailors" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={new URL(ogImage, baseUrl).href} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    {
      includeStructuredData && (
        <script is:inline type="application/ld+json" set:html={jsonLdString} />
      )
    }
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
    <Analytics />
    <ConsentBanner locale={lang} />
  </body>
</html>
