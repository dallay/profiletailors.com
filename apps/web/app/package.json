{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "portless": {
    "name": "pt-app",
    "script": "dev:app"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e:scheduler": "playwright test -c e2e/playwright.scheduler.config.ts",
    "test:e2e:scheduler:headed": "playwright test -c e2e/playwright.scheduler.config.ts --headed",
    "test:e2e:scheduler:debug": "playwright test -c e2e/playwright.scheduler.config.ts --debug"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@internationalized/date": "3.12.1",
    "@lucide/vue": "1.18.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/vue": "^1.6.5",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "pinia": "3.0.4",
    "reka-ui": "2.9.10",
    "shadcn-vue": "2.7.4",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "3.5.38",
    "vue-i18n": "11.4.5",
    "vue-input-otp": "^0.3.2",
    "vue-router": "5.1.0",
    "vue-sonner": "^2.0.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "4.3.1",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "25.9.3",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "9.0.2",
    "tailwindcss": "4.3.1",
    "typescript": "~6.0.3",
    "vite": "8.0.16",
    "vite-plugin-vue-devtools": "8.1.3",
    "vitest": "^4.1.8",
    "vue-tsc": "3.3.5"
  },
  "engines": {
    "node": "20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4"
    }
  }
}
