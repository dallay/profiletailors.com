{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "portless": {
    "name": "pt-app",
    "script": "dev:app"
  },
  "scripts": {
    "dev": "node scripts/check-portless.js && portless",
    "dev:app": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@formkit/drag-and-drop": "^0.6.0",
    "@lucide/vue": "1.16.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/vue": "^1.6.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "pinia": "3.0.4",
    "radix-vue": "1.9.17",
    "reka-ui": "2.9.7",
    "shadcn-vue": "2.7.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "3.5.34",
    "vue-i18n": "11.4.4",
    "vue-input-otp": "^0.3.2",
    "vue-router": "5.0.7",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "4.3.0",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "25.9.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "9.0.0",
    "tailwindcss": "4.3.0",
    "typescript": "~6.0.3",
    "vite": "8.0.13",
    "vite-plugin-vue-devtools": "8.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "3.3.1"
  },
  "engines": {
    "node": "20.19.0 || >=22.12.0"
