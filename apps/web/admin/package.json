{
  "name": "@profiletailors/admin",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "portless": {
    "name": "pt-admin",
    "script": "dev:app"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lucide/vue": "1.38.0",
    "@profiletailors/shared-web": "workspace:*",
    "@tanstack/vue-table": "^9.2.4",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "pinia": "4.0.3",
    "reka-ui": "2.10.4",
    "shadcn-vue": "2.8.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.0",
    "vue-sonner": "^2.0.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.3",
    "vite": "7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "3.3.11"
  }
}
