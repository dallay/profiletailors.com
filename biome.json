{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "experimentalScannerIgnores": ["tmp/**", "**/coverage/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "useBlockStatements": "off"
      },
      "a11y": {
        "useButtonType": "off"
      },
      "correctness": {
        "useParseIntRadix": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["apps/web/app/src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "useVueMultiWordComponentNames": "off",
            "noNonNullAssertion": "off"
          },
          "a11y": {
            "useSemanticElements": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useFocusableInteractive": "off",
            "useAnchorContent": "off",
            "useValidAnchor": "off",
            "useAriaPropsForRole": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noDocumentCookie": "off"
          },
          "correctness": {
            "useVueValidVBind": "off",
            "noVueDuplicateKeys": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/app/src/**/*.test.ts", "apps/web/app/src/**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/app/src/components/dashboard/shared/ScoreGauge.vue"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/app/src/components/CalendarCell.vue"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/app/src/components/CreatePostModal.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/marketing/**"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
