# ─────────────────────────────────────────────────────────────────────────────
# .bazelrc — Profile Tailors monorepo build configuration
# ─────────────────────────────────────────────────────────────────────────────

# ── Bzlmod (Module system) ────────────────────────────────────────────────────
common --enable_bzlmod

# ── Java toolchain ────────────────────────────────────────────────────────────
# rules_java@9.1.0 registers remotejdk up to version 21.
# Java 24 is used by the local Gradle build (server/smp) which runs outside
# the Bazel sandbox, so Bazel only needs a hermetic JDK for its own tooling.
build --java_language_version=21
build --tool_java_language_version=21
build --java_runtime_version=remotejdk_21

# ── Build behaviour ───────────────────────────────────────────────────────────
build --incompatible_enable_cc_toolchain_resolution
# Show output for failed actions
build --verbose_failures

# ── Performance ───────────────────────────────────────────────────────────────
build --jobs=HOST_CPUS*.75

# ── Local disk cache (all devs benefit; CI overrides with remote cache) ───────
build --disk_cache=~/.cache/bazel-disk-profiletailors
build --repository_cache=~/.cache/bazel-repo-profiletailors

# ── Test settings ─────────────────────────────────────────────────────────────
test --test_output=errors
test --test_summary=detailed

# ── CI profile ────────────────────────────────────────────────────────────────
# Usage: bazel build --config=ci //...
# Override with: --remote_cache=<url> in CI env
build:ci --announce_rc
build:ci --show_timestamps
build:ci --keep_going
build:ci --color=no

# ── Remote cache (opt-in, set remote_cache URL via env or user.bazelrc) ───────
# build:remote-cache --remote_cache=grpcs://your-cache-endpoint
# build:remote-cache --remote_upload_local_results=true
# build:remote-cache --remote_timeout=3600

# ── Compilation modes ─────────────────────────────────────────────────────────
build:opt --compilation_mode=opt
build:dbg --compilation_mode=dbg

# ── Android (placeholder — activate when apps/android is added) ───────────────
# build:android --fat_apk_cpu=arm64-v8a,x86_64
# build:android --android_crosstool_top=@androidndk//:toolchain

# ── iOS / macOS (placeholder — activate when apps/ios is added) ──────────────
# build:ios --apple_platform_type=ios
# build:macos --apple_platform_type=macos

# ── Per-user overrides (git-ignored) ─────────────────────────────────────────
try-import %workspace%/user.bazelrc
