SWARM_STACK_NAME=profile-tailors-swarm
SWARM_HTTP_PORT=8080
SWARM_STORAGE_NODE_LABEL=profiletailors.storage
SWARM_MEDIA_PATH=/var/lib/profiletailors/media
SWARM_RESOLVE_IMAGE=always

# Use immutable version tags or image digests published to a registry available to every node.
SMP_IMAGE=profiletailors/smp:0.1.0
DASHBOARD_IMAGE=profiletailors/dashboard:0.1.0
PUBLIC_ORIGIN=https://app.example.com

POSTGRES_DB=profiletailors_smp
POSTGRES_USER=profiletailors

DASHBOARD_REPLICAS=2
DASHBOARD_MEMORY_LIMIT=256M
DASHBOARD_MEMORY_RESERVATION=64M
DASHBOARD_CPU_LIMIT=0.50
DASHBOARD_CPU_RESERVATION=0.10
SMP_MEMORY_LIMIT=1G
SMP_MEMORY_RESERVATION=512M
SMP_CPU_LIMIT=1.50
SMP_CPU_RESERVATION=0.50
POSTGRES_MEMORY_LIMIT=1G
POSTGRES_MEMORY_RESERVATION=256M
POSTGRES_CPU_LIMIT=1.00
POSTGRES_CPU_RESERVATION=0.25

SMP_EMAIL_SENDER=noreply@example.com
SMP_LINKEDIN_CLIENT_ID=
SMP_MEDIAPROVIDER_UNSPLASH_ENABLED=false
SMP_PUBLISHING_WORKER_ENABLED=true
SMP_REGISTRATION_MODE=CLOSED

# Change a name to a new version before rotating an immutable Swarm secret.
SWARM_DB_PASSWORD_SECRET=profiletailors_db_password_v1
SWARM_LOCAL_JWT_SECRET=profiletailors_local_jwt_v1
SWARM_PUBLISHING_KEY_SECRET=profiletailors_publishing_key_v1
SWARM_MEDIA_SIGNING_SECRET=profiletailors_media_signing_v1
SWARM_LINKEDIN_STATE_SECRET=profiletailors_linkedin_state_v1
SWARM_LINKEDIN_CLIENT_SECRET=profiletailors_linkedin_client_v1
SWARM_RESEND_API_KEY_SECRET=profiletailors_resend_api_key_v1
