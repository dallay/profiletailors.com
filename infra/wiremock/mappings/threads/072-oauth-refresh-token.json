{
  "priority": 10,
  "request": {
    "method": "GET",
    "urlPath": "/refresh_access_token",
    "queryParameters": {
      "grant_type": { "equalTo": "th_refresh_token" },
      "access_token": { "matches": ".+" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "access_token": "mock-threads-refreshed-{{randomValue length=8 type='ALPHANUMERIC'}}",
      "token_type": "bearer",
      "expires_in": 5184000
    },
    "transformers": ["response-template"]
  }
}
