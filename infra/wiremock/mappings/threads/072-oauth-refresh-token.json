{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/v1.0/refresh_access_token",
    "headers": {
      "Content-Type": { "contains": "application/x-www-form-urlencoded" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$.grant_type" },
      { "matchesJsonPath": "$.access_token" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "access_token": "mock-threads-refreshed-{{randomValue length=8 type='ALPHANUMERIC'}}",
      "token_type": "bearer",
      "expires_in": 5184000
    },
    "transformers": ["response-template"]
  }
}
