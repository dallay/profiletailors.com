{
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1.0/[a-zA-Z0-9_-]*ERROR[a-zA-Z0-9_-]*",
    "queryParameters": {
      "fields": { "equalTo": "status" },
      "access_token": { "matches": "mock-threads-.+" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "status": "ERROR",
      "error_message": "Mocked container error"
    }
  }
}
