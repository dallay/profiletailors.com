{
  "priority": 10,
  "request": {
    "method": "GET",
    "urlPath": "/v1.0/oauth/authorize",
    "queryParameters": {
      "response_type": {
        "equalTo": "code"
      }
    }
  },
  "response": {
    "status": 302,
    "headers": {
      "Location": "{{#assign 'redirectUri'}}{{#if request.query.redirect_uri}}{{{request.query.redirect_uri}}}{{else}}https://pt-app.localhost/integrations/threads/callback{{/if}}{{/assign}}{{#assign 'separator'}}{{#if (contains redirectUri '?')}}&{{else}}?{{/if}}{{/assign}}{{redirectUri}}{{separator}}code=local-wiremock-threads-auth-code&state={{{request.query.state}}}"
    },
    "transformers": [
      "response-template"
    ]
  }
}
