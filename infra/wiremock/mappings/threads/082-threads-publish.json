{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v1.0/[a-zA-Z0-9-]+/threads_publish",
    "headers": {
      "Authorization": { "matches": "Bearer mock-threads-.+" },
      "Content-Type": { "contains": "application/x-www-form-urlencoded" }
    },
    "bodyPatterns": [
      { "matches": ".*access_token=mock-threads-.+.*" },
      { "matches": ".*creation_id=.+.*" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "id": "local-wiremock-post-{{randomValue length=12 type='NUMERIC'}}"
    },
    "transformers": ["response-template"]
  }
}
