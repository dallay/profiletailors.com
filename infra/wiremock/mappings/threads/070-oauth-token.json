{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/v1.0/oauth/access_token",
    "headers": {
      "Content-Type": { "contains": "application/x-www-form-urlencoded" }
    },
    "bodyPatterns": [
      { "matches": ".*client_id=.+.*" },
      { "matches": ".*client_secret=.+.*" },
      { "matches": ".*code=.+.*" },
      { "matches": ".*grant_type=authorization_code.*" },
      { "matches": ".*redirect_uri=.+.*" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "access_token": "mock-threads-short-lived-{{randomValue length=8 type='ALPHANUMERIC'}}",
      "token_type": "bearer",
      "expires_in": 3600,
      "user_id": "local-wiremock-threads-user-001"
    },
    "transformers": ["response-template"]
  }
}
