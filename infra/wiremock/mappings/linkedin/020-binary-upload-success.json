{
  "priority": 20,
  "request": {
    "method": "PUT",
    "urlPathPattern": "/dms-uploads/mock-(image|document|video)/uploaded-\\1/[0-9]+",
    "headers": {
      "Content-Type": { "matches": "application/octet-stream" }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "ETag": "mock-upload-etag-{{randomValue length=8 type='ALPHANUMERIC'}}"
    }
  }
}
