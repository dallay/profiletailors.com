{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/rest/videos",
    "queryParameters": {
      "action": { "equalTo": "initializeUpload" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$.initializeUploadRequest.owner" },
      { "matchesJsonPath": "$.initializeUploadRequest.fileSizeBytes" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "value": {
        "uploadUrlsExpireAt": 4102444800000,
        "video": "urn:li:video:local-wiremock-{{randomValue length=10 type='ALPHANUMERIC'}}",
        "uploadInstructions": [
          {
            "uploadUrl": "http://localhost:8089/dms-uploads/mock-video/uploaded-video/0",
            "firstByte": 0,
            "lastByte": 4194303
          }
        ],
        "uploadToken": "local-wiremock-upload-token"
      }
    },
    "transformers": ["response-template"]
  }
}
