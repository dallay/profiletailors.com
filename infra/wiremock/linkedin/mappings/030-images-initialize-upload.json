{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/rest/images",
    "queryParameters": {
      "action": { "equalTo": "initializeUpload" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$.initializeUploadRequest.owner" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "value": {
        "uploadUrlExpiresAt": 4102444800000,
        "uploadUrl": "http://localhost:8089/dms-uploads/mock-image/uploaded-image/0",
        "image": "urn:li:image:local-wiremock-{{randomValue length=10 type='ALPHANUMERIC'}}"
      }
    },
    "transformers": ["response-template"]
  }
}
