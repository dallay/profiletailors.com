# Profile Tailors Monorepo — Bazel MODULE
# https://bazel.build/external/module
module(
    name = "profiletailors",
    version = "0.0.0",
)

# ─────────────────────────────────────────────────────────────────────────────
# Core Bazel utilities
# ─────────────────────────────────────────────────────────────────────────────
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# ─────────────────────────────────────────────────────────────────────────────
# JavaScript / TypeScript / Node — apps/web/*
# ─────────────────────────────────────────────────────────────────────────────
bazel_dep(name = "aspect_rules_js", version = "2.3.7")
bazel_dep(name = "aspect_rules_ts", version = "3.5.2")
bazel_dep(name = "rules_nodejs", version = "6.3.5")

# Wire pnpm lockfile so Bazel knows the npm dependency graph
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = False)
npm.npm_translate_lock(
    name = "npm_marketing",
    pnpm_lock = "//apps/web/marketing:pnpm-lock.yaml",
    npmrc = "//apps/web/marketing:.npmrc",
    verify_node_modules_ignored = "//:.bazelignore",
    # Update with: bazel run @npm_marketing//:vendor
    update_pnpm_lock = False,
    data = [
        "//apps/web/marketing:package.json",
    ],
)
use_repo(npm, "npm_marketing")

# Node toolchain
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = False)
node.toolchain(node_version = "22.12.0")

# ─────────────────────────────────────────────────────────────────────────────
# JVM / Kotlin / Spring Boot — server/*
# ─────────────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_kotlin", version = "2.2.0")
bazel_dep(name = "rules_jvm_external", version = "6.9")

# Activate the rules_java toolchains extension so it registers the hermetic
# remotejdk repos (8, 11, 17, 21, 25). Without this use_extension call the
# repos are not wired into the module graph and BSP / IDE builds fail with
# "No matching toolchains found for @@bazel_tools//tools/jdk:toolchain_type".
java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(
    java_toolchains,
    "remotejdk21_macos_aarch64",
    "remote_java_tools",
    "remote_java_tools_darwin_arm64",
)

# Maven artifact resolution
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        # Spring Boot 4 BOM is applied via override_targets below;
        # list individual artifacts here for rules_jvm_external resolution.
        "org.springframework.boot:spring-boot-starter-data-r2dbc:4.0.6",
        "org.springframework.boot:spring-boot-starter-oauth2-resource-server:4.0.6",
        "org.springframework.boot:spring-boot-starter-security:4.0.6",
        "org.springframework.boot:spring-boot-starter-webflux:4.0.6",
        "org.springframework.security:spring-security-crypto:6.5.0",
        "io.projectreactor.kotlin:reactor-kotlin-extensions:1.2.3",
        "org.jetbrains.kotlin:kotlin-reflect:2.2.21",
        "org.jetbrains.kotlinx:kotlinx-coroutines-reactor:1.10.2",
        "org.liquibase:liquibase-core:4.32.0",
        "org.springdoc:springdoc-openapi-starter-webflux-ui:3.0.2",
        "org.springframework.modulith:spring-modulith-starter-core:2.0.6",
        "com.fasterxml.jackson.module:jackson-module-kotlin:2.19.0",
        "org.postgresql:postgresql:42.7.7",
        "org.postgresql:r2dbc-postgresql:1.0.7.RELEASE",
        # Test
        "com.h2database:h2:2.3.232",
        "io.r2dbc:r2dbc-h2:1.0.0.RELEASE",
        "org.jetbrains.kotlin:kotlin-test-junit5:2.2.21",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.10.2",
        "org.springframework.modulith:spring-modulith-starter-test:2.0.6",
        "org.testcontainers:junit-jupiter:1.20.6",
        "org.testcontainers:postgresql:1.20.6",
        "org.junit.platform:junit-platform-launcher:1.12.2",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://repo.spring.io/release",
    ],
    lock_file = "//:maven_install.json",
)
use_repo(maven, "maven", "unpinned_maven")

# ─────────────────────────────────────────────────────────────────────────────
# Container / Docker — server/smp image builds
# ─────────────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")

# ─────────────────────────────────────────────────────────────────────────────
# Version overrides — pin transitive deps that would otherwise resolve to a
# broken version.
# ─────────────────────────────────────────────────────────────────────────────

# rules_kotlin@2.2.0 pulls rules_android@0.6.4 → rules_go@0.51.0-rc2 which
# uses the removed CcInfo symbol, and registers a broken Android SDK toolchain.
# Force both to fixed releases.
single_version_override(
    module_name = "rules_go",
    version = "0.60.0",
)

single_version_override(
    module_name = "rules_android",
    version = "0.7.2",
)

# ─────────────────────────────────────────────────────────────────────────────
