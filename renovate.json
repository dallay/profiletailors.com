{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":enableVulnerabilityAlerts",
    ":labels(dependencies)",
    ":prNotPending"
  ],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "rangeStrategy": "bump",
  "prHourlyLimit": 3,
  "prConcurrentLimit": 10,
  "configMigration": true,
  "schedule": ["before 7am every weekday"],
  "timezone": "Europe/Madrid",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
      "schedule": ["before 7am on monday"]
  },
  "packageRules": [
    {
      "description": "Group Kotlin language updates",
      "matchManagers": ["gradle"],
      "groupName": "Kotlin",
      "groupSlug": "kotlin",
      "matchPackageNames": [
        "org.jetbrains.kotlin{/,}**"
      ]
    },
    {
      "description": "Group KotlinX coroutines & related",
      "matchManagers": ["gradle"],
      "groupName": "KotlinX",
      "groupSlug": "kotlinx",
      "matchPackageNames": [
        "org.jetbrains.kotlinx{/,}**"
      ]
    },
    {
      "description": "Group Cucumber BDD",
      "matchManagers": ["gradle"],
      "groupName": "Cucumber",
      "groupSlug": "cucumber",
      "matchPackageNames": [
        "io.cucumber{/,}**"
      ]
    },
    {
      "description": "Group Testcontainers",
      "matchManagers": ["gradle"],
      "groupName": "Testcontainers",
      "groupSlug": "testcontainers",
      "matchPackageNames": [
        "org.testcontainers{/,}**"
      ]
    },
    {
      "description": "Group Jackson (3.x line)",
      "matchManagers": ["gradle"],
      "groupName": "Jackson",
      "groupSlug": "jackson",
      "matchPackageNames": [
        "tools.jackson{/,}**"
      ]
    },
    {
      "description": "Group Spring Modulith",
      "matchManagers": ["gradle"],
      "groupName": "Spring Modulith",
      "groupSlug": "spring-modulith",
      "matchPackageNames": [
        "org.springframework.modulith{/,}**"
      ]
    },
    {
      "description": "Group Bucket4j + Caffeine (caching)",
      "matchPackageNames": ["com.bucket4j:bucket4j-core", "com.github.ben-manes.caffeine:caffeine"],
      "matchManagers": ["gradle"],
      "groupName": "Caching",
      "groupSlug": "caching"
    },
    {
      "description": "Group Spring Boot starters (managed by BOM, single PR)",
      "matchManagers": ["gradle"],
      "groupName": "Spring Boot",
      "groupSlug": "spring-boot",
      "matchPackageNames": [
        "org.springframework.boot{/,}**"
      ]
    },
    {
      "description": "Group Vue core ecosystem",
      "matchFileNames": ["apps/web/app/package.json", "shared/web/package.json"],
      "matchPackageNames": [
        "vue",
        "vue-router",
        "vue-i18n",
        "vue-sonner",
        "vue-tsc",
        "pinia"
      ],
      "groupName": "Vue Core",
      "groupSlug": "vue-core"
    },
    {
      "description": "Group Astro & related",
      "matchFileNames": ["apps/web/marketing/package.json"],
      "matchPackageNames": ["astro", "@astrojs/check", "@dallay/astro-icon"],
      "groupName": "Astro",
      "groupSlug": "astro"
    },
    {
      "description": "Group Tailwind CSS packages",
      "groupName": "Tailwind CSS",
      "groupSlug": "tailwindcss",
      "matchPackageNames": [
        "tailwindcss{/,}**",
        "@tailwindcss{/,}**"
      ]
    },
    {
      "description": "Group Playwright packages",
      "groupName": "Playwright",
      "groupSlug": "playwright",
      "matchPackageNames": [
        "@playwright{/,}**",
        "playwright{/,}**"
      ]
    },
    {
      "description": "Group Biome tooling",
      "groupName": "Biome",
      "groupSlug": "biome",
      "matchPackageNames": [
        "@biomejs{/,}**"
      ]
    },
    {
      "description": "Group Zod (shared + app use pinned versions)",
      "matchPackageNames": ["zod"],
      "groupName": "Zod",
      "groupSlug": "zod"
    },
    {
      "description": "Group Gradle wrapper updates",
      "matchPackageNames": ["gradle"],
      "matchManagers": ["gradle-wrapper"],
      "groupName": "Gradle Wrapper",
      "groupSlug": "gradle-wrapper",
      "labels": ["dependencies", "gradle"],
      "addLabels": ["gradle"]
    },
    {
      "description": "Auto-merge safe dev dependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge safe GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge safe Gradle plugin patch updates",
      "matchManagers": ["gradle"],
      "matchDepTypes": ["plugin"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Patch updates for lockfile-overridden deps — auto-merge safe",
      "matchPackageNames": ["esbuild", "undici", "hono", "js-yaml", "devalue", "yaml"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Major updates: scheduled for Monday review",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"],
      "addLabels": ["major-update"],
      "schedule": ["before 7am on monday"],
      "assignees": ["yacosta738"],
      "reviewers": ["yacosta738"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "addLabels": ["security"]
  },
  "assignees": ["yacosta738"],
  "reviewers": ["yacosta738"]
}
